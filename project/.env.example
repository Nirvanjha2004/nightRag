# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)

# ---------------------------------------------------------------- required

# Jina AI — embeds code chunks and queries (jina-embeddings-v5-text-small).
# Free tier: https://jina.ai/embeddings/
jina_api_key=

# Groq — runs the reranker, the corrective-RAG grader and the final answer.
# Free tier: https://console.groq.com/keys
groq_api_key=

# ---------------------------------------------------------------- optional

# Where the embedded Qdrant store lives. One process at a time owns this
# directory, so the server and the CLI cannot both run against it.
# NIGHTRAG_QDRANT_DIR=qdrant_data

# Use a Qdrant server instead of the embedded store (lifts the one-process
# limit; required if you want more than one NightRag instance).
# NIGHTRAG_QDRANT_URL=http://localhost:6333

# Defaults the UI starts from. Every one can be overridden per question.
# NIGHTRAG_COLLECTION=code_chunks
# NIGHTRAG_MODEL=openai/gpt-oss-120b

# Where the server listens. 127.0.0.1 keeps it on this machine only.
# NIGHTRAG_HOST=127.0.0.1
# NIGHTRAG_PORT=8000

# Only needed when the UI is served from a different origin than the API
# (comma-separated). Same-origin deployments should leave this unset.
# NIGHTRAG_CORS_ORIGINS=http://localhost:5173

# Ingestion sources. "Folder" reads the filesystem of the machine running the
# server — set this to 0 if anyone but you can reach it.
# NIGHTRAG_ALLOW_LOCAL_PATH=1
# NIGHTRAG_ALLOW_GIT_CLONE=1
# NIGHTRAG_MAX_UPLOAD_MB=64

# Built UI location, relative to the project root.
# NIGHTRAG_WEB_DIST=web/dist
